# nevr_build_stamp_targets(): the build's identity as two targets (#1935; the script is cmake/nevr_build_stamp.cmake).
#
#   nevr_build_stamp_refresh  a custom target with no outputs: it runs the script at every build, so the stamp follows
#                             the commit and the tree (a commit or an uncommitted edit shows at the next build, with no
#                             configure).
#   nevr_build_stamp          a STATIC library holding the one generated unit, build/generated/nevr_build_stamp.cpp,
#                             which defines the accessors of src/core/build_stamp.h. Link it to each target whose
#                             sources call them. The unit is rewritten only when its content changes.
#
#   nevr_build_stamp_targets(REPO_DIR <dir> [APK_TOOL <tools/quest_apk_version.py>] [PYTHON <python3>])
#       REPO_DIR is the checkout whose VERSION and git state are stamped. APK_TOOL, given by the Quest build only, makes
#       the unit carry that build's versionCode.
#
# Call it once, from the root CMakeLists.txt (or the Quest project), before any target that links the library. Configure
# runs the script once so the unit exists; a failing script (no reachable release tag, a release tag on a dirty tree)
# stops the configure with the script's own message.

set(_NEVR_BUILD_STAMP_TARGETS_DIR "${CMAKE_CURRENT_LIST_DIR}")

function(nevr_build_stamp_targets)
  cmake_parse_arguments(PARSE_ARGV 0 _bs "" "REPO_DIR;APK_TOOL;PYTHON" "")
  if(NOT _bs_REPO_DIR)
    message(FATAL_ERROR "nevr_build_stamp_targets: REPO_DIR is required")
  endif()
  if(TARGET nevr_build_stamp)
    message(FATAL_ERROR "nevr_build_stamp_targets: called twice in one project")
  endif()

  set(_script "${_NEVR_BUILD_STAMP_TARGETS_DIR}/nevr_build_stamp.cmake")
  set(_out "${CMAKE_BINARY_DIR}/generated/nevr_build_stamp.cpp")
  set(_args
      "-DNEVR_STAMP_SOURCE_DIR=${_bs_REPO_DIR}"
      "-DNEVR_STAMP_OUTPUT=${_out}"
      "-DNEVR_STAMP_GIT=${GIT_EXECUTABLE}")
  if(_bs_APK_TOOL)
    list(APPEND _args "-DNEVR_STAMP_APK_TOOL=${_bs_APK_TOOL}")
  endif()
  if(_bs_PYTHON)
    list(APPEND _args "-DNEVR_STAMP_PYTHON=${_bs_PYTHON}")
  endif()

  # Configure: the unit must exist before CMake looks at it. A refusal here is the script's own message.
  execute_process(COMMAND "${CMAKE_COMMAND}" ${_args} -P "${_script}"
                  RESULT_VARIABLE _rc OUTPUT_VARIABLE _out_text ERROR_VARIABLE _err_text)
  if(NOT _rc EQUAL 0)
    message(FATAL_ERROR "nevr_build_stamp_targets: the build stamp was refused:\n${_err_text}${_out_text}")
  endif()
  # The script reads VERSION and git; both change the stamp, so both are configure dependencies of the directory.
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_bs_REPO_DIR}/VERSION")

  # Ninja decides a build's dirty edges before any command runs, so a unit regenerated by a command that has no
  # dependency of its own would be judged on the file as it was at the start. The refresh target therefore touches a
  # byproduct at every build, and the unit's generator depends on it: the generator runs at every build, its output is
  # restat, so the unit recompiles only when the script rewrote it with new content (copy_if_different keeps the mtime
  # when the content is the same).
  set(_tick "${CMAKE_BINARY_DIR}/generated/nevr_build_stamp.tick")
  add_custom_target(nevr_build_stamp_refresh
    COMMAND "${CMAKE_COMMAND}" -E touch "${_tick}"
    BYPRODUCTS "${_tick}"
    VERBATIM)
  set_source_files_properties("${_tick}" PROPERTIES SYMBOLIC TRUE GENERATED TRUE)
  add_custom_command(OUTPUT "${_out}"
    COMMAND "${CMAKE_COMMAND}" ${_args} -P "${_script}"
    DEPENDS "${_tick}"
    VERBATIM)

  add_library(nevr_build_stamp STATIC "${_out}")
  set_source_files_properties("${_out}" PROPERTIES GENERATED TRUE SKIP_PRECOMPILE_HEADERS ON)
  target_include_directories(nevr_build_stamp PUBLIC "${_bs_REPO_DIR}/src")
  add_dependencies(nevr_build_stamp nevr_build_stamp_refresh)
endfunction()

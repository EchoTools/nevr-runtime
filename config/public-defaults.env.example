# The public client defaults: the service endpoints and the public keys every client embeds.
# Copy to config/public-defaults.env (git-ignored) and fill in the four values. The build reads that
# file and nothing else (cmake/nevr_builtin_defaults.cmake): not .env, not the environment. CI writes
# it from the repository's Actions variables (NEVR_SOCKET_URI, NEVR_HTTP_URI, NEVR_PUBLIC_API_KEY,
# NEVR_PUBLIC_SOCKET_KEY) before it configures.
#
# At run time config.yaml overrides what is embedded, and the environment variables NEVR_API_KEY /
# NEVR_SOCKET_KEY override both for the two keys (#76).

# Service bridge target for the token-auth path: the `/nevr` ingress (the `/ws` front replaces the
# client's Bearer token with the server key, #52). A wss://<host>/nevr URL.
NEVR_SOCKET_URI=
# Nakama HTTP base for device-code auth and token refresh.
NEVR_HTTP_URI=
# Public API key (the Nakama HTTP key): public by design, embedded in every client.
NEVR_PUBLIC_API_KEY=
# Public socket key (the Nakama server key): public by design, embedded in every client.
NEVR_PUBLIC_SOCKET_KEY=

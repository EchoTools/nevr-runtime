#!/usr/bin/env bash
# pre-push: refuse a push whose tree has a script recorded without its executable bit (#794).
#
# core.fileMode=false made `git add` forget the exec bit on three scripts in one day, and the timer or
# `just verify` then failed with exit 126 on a fresh checkout. The check is the repo's own
# tools/tests/test_executable_scripts.py, run in the tree being pushed from. It never reads the push
# arguments or the network; it fails loudly (exit 1, the test's output on stderr) and has no bypass
# other than git's own `--no-verify`.
set -u

top="$(git rev-parse --show-toplevel)" || { echo "pre-push: not inside a work tree" >&2; exit 1; }
test_file="$top/tools/tests/test_executable_scripts.py"
if [ ! -f "$test_file" ]; then
    echo "pre-push: $test_file does not exist; merge origin/main into this branch, then push again" >&2
    exit 1
fi
if ! out="$(cd "$top" && python3 -I "$test_file" 2>&1)"; then
    printf '%s\n' "$out" >&2
    echo "pre-push: refusing the push; record the exec bit with 'git update-index --chmod=+x <path>'" >&2
    exit 1
fi
exit 0

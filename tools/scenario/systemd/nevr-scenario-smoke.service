[Unit]
Description=NEVR social-scenario smoke: one client boot proving in-game, control endpoint and a fire round-trip
# The scenario suite is not in CI (GitHub runners have no Echo VR install or account), so this
# scheduled check on spriffy is what catches a regression like the 2026-10-03 drop of -mp.

[Service]
Type=oneshot
# The smoke runs from a worktree of its own that tracks origin/main: smoke.sh fast-forwards it before
# it builds, so the timer never runs a dev branch. Set it up once: tools/scenario/systemd/README.md.
WorkingDirectory=/home/andrew/src/nevr-runtime/.claude/worktrees/nevr-scenario-smoke
ExecStart=/home/andrew/src/nevr-runtime/.claude/worktrees/nevr-scenario-smoke/tools/scenario/smoke.sh
# The build shares the nevr build slice and its caps (AGENTS.md "Builds").
Slice=nevr-builds.slice
MemoryMax=8G
Environment=VCPKG_MAX_CONCURRENCY=6 CMAKE_BUILD_PARALLEL_LEVEL=6
# The client runs on the nested display, never the owner's desktop (run_scenario.py also forces :101).
UnsetEnvironment=WAYLAND_DISPLAY
# A non-zero exit is a failed unit; the alarm inside smoke.sh (bonk Andrew + courier spritz) is what
# makes it loud. No restart loop: a smoke failure is a record + alarm, not a retry.

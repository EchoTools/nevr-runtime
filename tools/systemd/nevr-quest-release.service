[Unit]
Description=nevr-runtime Quest release: build, publish and list the Quest APK of a new release tag (#1210)
OnFailure=nevr-quest-release-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/src/nevr-runtime-work/release-timer/checkout
# The R2 credential: R2_ENDPOINT, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY. It never appears in this file.
EnvironmentFile=%h/.config/metis/r2-evr-echo-taxi.env
# Optional (the dash): NEVR_VARIANT_DIR and NEVR_VARIANT_PINS, which switch on the variant APK (RELEASING.md, "The Quest half of
# the train"). A machine without the file builds the main release only. It never appears in this repository.
EnvironmentFile=-%h/.config/metis/quest-variant.env
Environment=RELEASE_PUBLIC_BASE=https://evr.echo.taxi
# The Quest key is read by pass(1), which runs gpg. gpg keeps its keyring in GNUPGHOME (gpg(1): the GNUPGHOME environment
# variable sets the home directory, and the gpg-agent socket directory is derived from it), and the keyring is in the XDG
# home. Without this the unit's gpg reads ~/.gnupg, which has no secret key (systemd.exec(5): Environment=).
Environment=GNUPGHOME=%h/.config/gnupg
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# The probe runs before anything else, every minute: one GitHub call, no git and no credential. Exit 1 (idle) skips the unit
# without failing it; exit 255 (the probe itself failed) fails it, which starts the failure notice.
ExecCondition=/usr/bin/python3 -I %h/src/nevr-runtime-work/release-timer/checkout/tools/quest_release_timer.py --probe
# The checkout is the timer's own: it moves it to the freshly fetched origin/main, and the tool refuses a dirty one or one
# that is not at origin/main.
ExecStartPre=/usr/bin/git -C %h/src/nevr-runtime-work/release-timer/checkout fetch --quiet origin main
ExecStartPre=/usr/bin/git -C %h/src/nevr-runtime-work/release-timer/checkout switch --quiet --detach origin/main
ExecStart=/usr/bin/python3 -I %h/src/nevr-runtime-work/release-timer/checkout/tools/quest_release_timer.py --stage-draft
TimeoutStartSec=3h

[Unit]
Description=nEVR Quest release: build, publish and list the Quest APK of a new release tag (#1210)
OnFailure=nevr-quest-release-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/src/nevr-runtime
# The R2 credential: R2_ENDPOINT, R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY. It never appears in this file.
EnvironmentFile=%h/.config/metis/r2-evr-echo-taxi.env
Environment=RELEASE_PUBLIC_BASE=https://evr.echo.taxi
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/python3 -I %h/src/nevr-runtime/tools/quest_release_timer.py
TimeoutStartSec=3h

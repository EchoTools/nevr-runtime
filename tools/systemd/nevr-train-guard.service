[Unit]
Description=nevr-runtime release train guard: dispatch the train when a scheduled run was dropped (#1409)
OnFailure=nevr-train-guard-failed.service

[Service]
Type=oneshot
WorkingDirectory=%h/src/nevr-runtime-work/release-timer/checkout
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# The checkout is the timer's dedicated one (the Quest timer's). The guard reads origin/main's version tool, so the unit
# fetches and moves the checkout to the freshly fetched origin/main before every run.
ExecStartPre=/usr/bin/git -C %h/src/nevr-runtime-work/release-timer/checkout fetch --quiet --tags origin main
ExecStartPre=/usr/bin/git -C %h/src/nevr-runtime-work/release-timer/checkout switch --quiet --detach origin/main
# gh is the publisher's own gh-spritz (it reads variables, which a job token cannot); the decision log is the state file.
ExecStart=/usr/bin/python3 -I %h/src/nevr-runtime-work/release-timer/checkout/tools/release_train_guard.py --repo EchoTools/nevr-runtime
TimeoutStartSec=10min

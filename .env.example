# Runtime-only local overrides. Copy to .env (git-ignored). The build never reads this file:
# the public client defaults are config/public-defaults.env (see config/public-defaults.env.example),
# embedded at build time.
#
# At run time, config.yaml overrides what is embedded, and the environment variables below
# override both for the two keys (#76). Leave a value empty to use the embedded default.

# Nakama HTTP key override.
NEVR_API_KEY=
# Nakama server key override.
NEVR_SOCKET_KEY=

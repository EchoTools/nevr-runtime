# Local settings. Copy to .env (git-ignored). `just` loads it into every recipe's environment (`set dotenv-load`); the
# build itself never reads it: the public client defaults are config/public-defaults.env (see
# config/public-defaults.env.example), embedded at build time.
#
# At run time, config.yaml overrides what is embedded, and the environment variables below
# override both for the two keys (#76). Leave a value empty to use the embedded default.

# Nakama HTTP key override.
NEVR_API_KEY=
# Nakama server key override.
NEVR_SOCKET_KEY=

# Release inputs (#1997). `just` loads this file (`set dotenv-load`), and `just release-check` names any that is
# missing or wrong. One name each; paths are absolute.
# The reference base APK the Quest release APK is repacked from.
NEVR_QUEST_REFERENCE_APK=
# The Quest APK signing keystore, and its store passphrase.
NEVR_QUEST_KEYSTORE=
NEVR_QUEST_KEYSTORE_PASS=
# The release host (R2), and the rclone remote that names its bucket.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
NEVR_RCLONE_REMOTE=
# The release host's public base URL.
RELEASE_PUBLIC_BASE=
# The release-signer executable and its checkout.
RELEASE_SIGNER_BIN=
RELEASE_SIGNER_DIR=
# A GitHub token for this repository.
GH_TOKEN=

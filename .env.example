# Build-time defaults embedded into BugSplat64.dll (read by CMake at configure time).
# Copy to .env (git-ignored) and fill in. The real environment overrides this file.
# At run time, config.yaml overrides anything embedded here, and the environment variables
# NEVR_API_KEY / NEVR_SOCKET_KEY override both for the two keys (#76). Those two are read by
# the runtime only; the build ignores them. An unset or empty value embeds nothing (the
# runtime then needs it from config.yaml or the environment).
#
# After editing, re-run `just configure` (CMake re-configures automatically because it
# tracks this file).

# Service bridge target the runtime relays login/config/matchmaking to. For the token-auth
# path (no identity/password in config.yaml) use the `/nevr` ingress on the game host:
# it forwards the client's `Authorization: Bearer <JWT>`, whereas `/ws` makes the front inject
# the server key over it and the session arrives unauthenticated (see issue #52). URL-credential
# logins (identity.discord_id + auth.password in config.yaml) keep using `/ws`.
NEVR_SOCKET_URI=
# Nakama HTTP base used for device-code auth and token refresh.
NEVR_HTTP_URI=
# Public API key (the Nakama HTTP key): public by design, embedded in every client. Runtime
# override: NEVR_API_KEY.
NEVR_PUBLIC_API_KEY=
# Public socket key (the Nakama server key): public by design, embedded in every client.
# Runtime override: NEVR_SOCKET_KEY.
NEVR_PUBLIC_SOCKET_KEY=

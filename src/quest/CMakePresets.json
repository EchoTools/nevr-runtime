{
    "version": 4,
    "configurePresets": [
        {
            "name": "android-arm64",
            "displayName": "Android arm64-v8a (NDK r26d, API 26)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../../build/android-arm64",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_MANIFEST_DIR": "${sourceDir}",
                "VCPKG_TARGET_TRIPLET": "arm64-android",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-26",
                "ANDROID_STL": "c++_static",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "android-arm64-dev",
            "displayName": "Android arm64-v8a for a local package (just package-dev): its own build tree",
            "inherits": "android-arm64",
            "binaryDir": "${sourceDir}/../../build/android-dev"
        },
        {
            "name": "quest-host-base",

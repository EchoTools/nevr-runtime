# ctest wrapper: an object's unwind frames sit under the personality-free CIE ("zR"), none under a personality ("zPLR").
#   cmake -DREADELF=<readelf> -DOBJECT=<file.o> -P check_frames.cmake
foreach(var READELF OBJECT)
  if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
    message(FATAL_ERROR "check_frames.cmake: ${var} is not set")
  endif()
endforeach()
get_filename_component(name "${OBJECT}" NAME)
execute_process(COMMAND "${READELF}" --debug-dump=frames "${OBJECT}" RESULT_VARIABLE rc OUTPUT_VARIABLE frames)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "FAIL - readelf could not read ${OBJECT} (exit ${rc})")
endif()
string(FIND "${frames}" "\"zPLR\"" personality)
if(NOT personality EQUAL -1)
  message(FATAL_ERROR "FAIL - ${name} has frames under a personality CIE (zPLR)")
endif()
string(FIND "${frames}" "\"zR\"" plain)
if(plain EQUAL -1)
  message(FATAL_ERROR "FAIL - ${name} has no zR frames to check")
endif()
message("${name}: frames are all under the zR CIE, none under zPLR")

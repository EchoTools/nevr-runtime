# ctest wrapper: run a program and require its exit status and what it printed.
#   cmake -DCMD=<program> [-DCMD_ARGS=<a|b|c>] -DEXPECT_RC=<number|nonzero|SIGILL> [-DEXPECT_OUT=<a|b>] -P expect_exit.cmake
# SIGILL is a process ended by an illegal instruction (__builtin_trap): the shell reports it as exit status 132.
# CMD_ARGS and EXPECT_OUT are lists separated by '|'. The program's output is printed.
foreach(var CMD EXPECT_RC)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "expect_exit.cmake: ${var} is not set")
  endif()
endforeach()
string(REPLACE "|" ";" args "${CMD_ARGS}")
execute_process(COMMAND "${CMD}" ${args} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
set(all "${out}${err}")
message("${all}")
if(EXPECT_RC STREQUAL "nonzero")
  if(rc EQUAL 0)
    message(FATAL_ERROR "${CMD} exited 0, but must fail")
  endif()
elseif(EXPECT_RC STREQUAL "SIGILL")
  if(NOT rc STREQUAL "Illegal instruction")
    message(FATAL_ERROR "${CMD} ended with '${rc}', not by an illegal instruction (SIGILL, shell status 132)")
  endif()
elseif(NOT rc STREQUAL "${EXPECT_RC}")
  message(FATAL_ERROR "${CMD} exited ${rc}, not ${EXPECT_RC}")
endif()
string(REPLACE "|" ";" wanted "${EXPECT_OUT}")
foreach(text IN LISTS wanted)
  string(FIND "${all}" "${text}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "${CMD}: its output does not hold '${text}'")
  endif()
endforeach()

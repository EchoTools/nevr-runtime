; LibOVRPlatform64_1.dll — stub export definitions
; Minimum set required for pnsovr.dll to load without the real Oculus SDK.
; Built from IAT analysis + GetProcAddress strings in the EchoVR reconstruction.
;
; Two import vectors in pnsovr.dll:
;   1. GetProcAddress (OVRPlatformInit.cpp:ovr_ResolveSDKFunctions) — 7 init functions
;   2. IAT static imports — everything else (voip, microphone, users, rooms, etc.)

LIBRARY LibOVRPlatform64_1
EXPORTS
    ; =========================================================================
    ; Platform initialization (GetProcAddress-resolved in pnsovr.dll)
    ; =========================================================================
    ovr_PlatformInitializeWindows
    ovr_PlatformInitializeWindowsAsynchronous
    ovr_PlatformInitializeWithAccessToken
    ovr_PlatformInitializeWithAccessTokenAndOptions
    ovr_PopMessage
    ovr_PlatformInitializeStandaloneAccessToken
    ovr_Platform_InitializeStandaloneOculus
    ovr_IsPlatformInitialized

    ; =========================================================================
    ; Message handling
    ; =========================================================================
    ovr_FreeMessage
    ovr_Message_GetType
    ovr_Message_GetRequestID
    ovr_Message_IsError
    ovr_Message_GetString
    ovr_Message_GetError
    ovr_Message_GetUser
    ovr_Message_GetUserArray
    ovr_Message_GetUserAndRoomArray
    ovr_Message_GetUserProof
    ovr_Message_GetOrgScopedID
    ovr_Message_GetProductArray
    ovr_Message_GetPurchase
    ovr_Message_GetPurchaseArray
    ovr_Message_GetDestinationArray
    ovr_Message_GetRoom
    ovr_Message_GetRoomInviteNotification
